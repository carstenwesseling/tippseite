rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Tabellen, Halbserien und Ergebnisse sind öffentlich lesbar, schreiben nur Admins.
    match /rounds/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /players/{p} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    match /results/{jahr} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Einstellungen (z. B. Termin der nächsten Tippfete): öffentlich lesbar, schreiben nur Admins.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Umfrage zur Tippfete: öffentlich lesbar sind nur die Anzahlen (settings/tippfeteCounts). Eine Stimme darf neu angelegt oder
    // geändert (k <-> n) werden, und nur zusammen mit der passenden Anpassung am Zähler. Namen/Stimmen auflisten: nur Admins.
    match /settings/tippfeteCounts {
      allow update: if request.resource.data.keys().hasOnly(['k', 'n', 'last'])
        && request.resource.data.last is string
        && existsAfter(/databases/$(database)/documents/tippfeteVotes/$(request.resource.data.last))
        && (
          // neue Stimme: +1 bei der gewählten Antwort
          (!exists(/databases/$(database)/documents/tippfeteVotes/$(request.resource.data.last))
            && ((getAfter(/databases/$(database)/documents/tippfeteVotes/$(request.resource.data.last)).data.antwort == 'k'
                  && request.resource.data.k == resource.data.k + 1 && request.resource.data.n == resource.data.n)
              || (getAfter(/databases/$(database)/documents/tippfeteVotes/$(request.resource.data.last)).data.antwort == 'n'
                  && request.resource.data.n == resource.data.n + 1 && request.resource.data.k == resource.data.k)))
          // Änderung einer bestehenden Stimme: eine Stimme wandert von der alten zur neuen Antwort
          || (exists(/databases/$(database)/documents/tippfeteVotes/$(request.resource.data.last))
            && ((get(/databases/$(database)/documents/tippfeteVotes/$(request.resource.data.last)).data.antwort == 'k' && getAfter(/databases/$(database)/documents/tippfeteVotes/$(request.resource.data.last)).data.antwort == 'n'
                  && request.resource.data.k == resource.data.k - 1 && request.resource.data.n == resource.data.n + 1)
              || (get(/databases/$(database)/documents/tippfeteVotes/$(request.resource.data.last)).data.antwort == 'n' && getAfter(/databases/$(database)/documents/tippfeteVotes/$(request.resource.data.last)).data.antwort == 'k'
                  && request.resource.data.n == resource.data.n - 1 && request.resource.data.k == resource.data.k + 1)))
        );
    }
    match /tippfeteVotes/{id} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'antwort', 'at'])
        && request.resource.data.antwort in ['k', 'n']
        && request.resource.data.name is string && request.resource.data.name.size() < 80
        && getAfter(/databases/$(database)/documents/settings/tippfeteCounts).data.last == id;
      allow update: if request.resource.data.keys().hasOnly(['name', 'antwort', 'at'])
        && request.resource.data.antwort in ['k', 'n']
        && request.resource.data.antwort != resource.data.antwort
        && request.resource.data.name == resource.data.name
        && getAfter(/databases/$(database)/documents/settings/tippfeteCounts).data.last == id;
    }
    // Mitgliederverwaltung: nur Admins.
    match /members/{id} {
      allow read, write: if isAdmin();
    }
    // Tipper (Mitspieler der Tipprunde): Namen und Haken öffentlich (Auswahlliste im Tippformular); Mailadressen nur für Admins.
    match /tippers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tipperMail/{id} {
      allow read, write: if isAdmin();
    }

    // Tipprunde: öffentlich lesbar. Tipps einzelner Mitglieder darf lesen, wer die Dokument-ID (= Name) kennt;
    // die Gesamtliste nur Admins. Schreiben darf jeder, solange die Runde offen ist und das Mitglied einen Haken hat.
    match /tipping/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /tips/{m} {
        allow get: if true;
        allow list, delete: if isAdmin();
        // Neu anlegen: Runde offen, Mitglied hat Haken. Überschreiben nur, solange der Tipp nicht abgeschickt (locked) ist;
        // danach schaltet ein Admin ihn in der Mitgliederverwaltung frei.
        allow create: if get(/databases/$(database)/documents/tipping/$(id)).data.open == true
          && get(/databases/$(database)/documents/tippers/$(m)).data.aktiv == true
          && request.resource.data.keys().hasOnly(['name', 'tips', 'updatedAt', 'locked']);
        allow update: if resource.data.get('locked', false) != true
          && get(/databases/$(database)/documents/tipping/$(id)).data.open == true
          && get(/databases/$(database)/documents/tippers/$(m)).data.aktiv == true
          && request.resource.data.keys().hasOnly(['name', 'tips', 'updatedAt', 'locked']);
        allow update: if isAdmin();
      }
    }

    // Excel-Mail (Erweiterung "Trigger Email from Firestore", Sammlung `mail`): nur an die im Admin hinterlegte
    // Adresse eines aktiven Mitglieds, bei dem "Excel per Mail" angehakt ist.
    match /mail/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['tipperId', 'to', 'message'])
        && request.resource.data.to is list && request.resource.data.to.size() == 1
        && get(/databases/$(database)/documents/tippers/$(request.resource.data.tipperId)).data.sendExcel == true
        && get(/databases/$(database)/documents/tippers/$(request.resource.data.tipperId)).data.aktiv == true
        && get(/databases/$(database)/documents/tipperMail/$(request.resource.data.tipperId)).data.email.lower()
           == request.resource.data.to[0].lower();
    }

    // Jeder Angemeldete darf nur den eigenen Admin-Eintrag lesen; Einträge legt man in der Firebase-Konsole an.
    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }
  }
}
